@model MiniERP.Domain.Entities.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4 text-danger">Delete Product</h2>

            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this product?
                </h4>
                <p class="mb-0">This action will mark the product as inactive.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Code</dt>
                        <dd class="col-sm-9">@Model.Code</dd>

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">@Model.Category.Name</dd>

                        <dt class="col-sm-3">Cost Price</dt>
                        <dd class="col-sm-9">@Model.CostPrice.ToString("C")</dd>

                        <dt class="col-sm-3">Sale Price</dt>
                        <dd class="col-sm-9">@Model.SalePrice.ToString("C")</dd>

                        <dt class="col-sm-3">Stock</dt>
                        <dd class="col-sm-9">@Model.Stock</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
